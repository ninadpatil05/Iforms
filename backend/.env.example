# Database Connection String (PostgreSQL or SQLite fallback)
DATABASE_URL=sqlite:///./sql_app.db

# JWT Authentication Secret Key (Replace with a strong random string in production)
SECRET_KEY=change_this_to_a_secure_secret_key_12345

# JWT Signing Algorithm
ALGORITHM=HS256

# JWT Access Token Expiration Time in Minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed CORS Origins (JSON list of URLs)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Public Frontend Base URL (used for generating form links in emails)
PUBLIC_APP_URL=http://localhost:5173

# Google OAuth 2.0 Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# System SMTP Email Configuration
# SMTP server hostname (e.g., smtp.gmail.com, sandbox.smtp.mailtrap.io)
SMTP_HOST=smtp.gmail.com

# SMTP server port (e.g., 587 for TLS/STARTTLS, 465 for SSL)
SMTP_PORT=587

# SMTP authentication username
SMTP_USERNAME=your_email@example.com

# SMTP authentication password or app password
SMTP_PASSWORD=your_smtp_app_password

# Default sender email address (appears as the From address)
SMTP_FROM_EMAIL=your_email@example.com

# Default sender display name
SMTP_FROM_NAME=IForms Platform

# Use TLS / STARTTLS for SMTP connection (true/false)
SMTP_USE_TLS=true

# AI Feature Configuration
# AI provider to use (default: gemini)
AI_PROVIDER=gemini

# Gemini API Key (required for AI form generation and response analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model name
GEMINI_MODEL=gemini-2.5-flash

# Hard timeout in seconds per AI request
AI_REQUEST_TIMEOUT_SECONDS=30

# Maximum retries for transient AI provider errors
AI_MAX_RETRIES=2

